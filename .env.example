VITE_API_BASE_URL=/api

# Vite dev proxy target for local PHP/XAMPP:
VITE_API_PROXY_TARGET=http://localhost/e-commerce/backend/public/index.php

# If your htdocs folder name is different, update the proxy target to match it.

VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost/e-commerce/order-success

# Local admin login fallback for the PHP backend
ADMIN_FULL_NAME=Store Owner
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe123!
